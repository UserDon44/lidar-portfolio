data/raw/
output/*
!output/reports/
scripts/__pycache__/

# Claude Code config: track the policy, never the accumulated local allows.
# NOTE: must be '.claude/*' plus negations, not '.claude/' -- git does not
# traverse into a fully-excluded directory to find negation rules inside.
.claude/*
!.claude/settings.json
!.claude/hooks/
# Hook run-artifacts: regenerated every session, never source.
# This was previously a single exact filename, so two new artifacts
# (last_session_banner.txt, last_closeout_check.txt) slipped straight
# into a commit. A pattern, not a list of names.
.claude/hooks/last_*.txt
.claude/hooks/__pycache__/

# The non-deliverable marker is tracked; the renders themselves are not.
!output/renders_personal/
output/renders_personal/*
!output/renders_personal/README.md
